      "name": "¿Es ✅?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -384,
        -96
      ],
      "notes": "Solo continúa si el emoji es exactamente ✅ (white_check_mark)"
    },
    {
      "parameters": {
        "jsCode": "const messages = $input.item.json.messages;\n\nif (!messages || messages.length === 0) {\n  throw new Error('No se encontró el mensaje original');\n}\n\nconst text = messages[0].text || '';\n\nconst match = text.match(/tickets\\/([\\d]+)/);\n\nif (!match) {\n  throw new Error('No se encontró número de ticket en el mensaje: ' + text);\n}\n\nconst ticketNumber = match[1];\nconst originalTs = messages[0].ts;\nconst channel = $('Slack - Reaction Added').item.json.item.channel;\n\nreturn {\n  ticketNumber,\n  originalTs,\n  channel,\n  searchText: `tickets/${ticketNumber}`\n};"
      },
      "id": "68f06ad8-f457-4b97-a436-3f85cc1a54b8",
      "name": "Extraer número de ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -112
      ],
      "notes": "Parsea el texto con regex para obtener el número de ticket del link de Freshdesk"
    },
    {
      "parameters": {
        "jsCode": "const allMessages = $input.item.json.messages || [];\nconst ticketNumber = $('Extraer número de ticket').item.json.ticketNumber;\nconst originalTs = $('Extraer número de ticket').item.json.originalTs;\nconst channel = $('Extraer número de ticket').item.json.channel;\nconst searchText = `tickets/${ticketNumber}`;\n\n// Debug\nconsole.log('Total mensajes:', allMessages.length);\nconsole.log('Buscando:', searchText);\n\nconst withTicket = allMessages.filter(msg => (msg.text || '').includes(searchText));\nconsole.log('Mensajes con ticket:', withTicket.length);\nconsole.log('Sus ts:', withTicket.map(m => m.ts));\nconsole.log('Sus reacciones:', JSON.stringify(withTicket.map(m => m.reactions)));\n\nconst duplicates = allMessages.filter(msg => {\n  const hasTicket = (msg.text || '').includes(searchText);\n  const isNotOriginal = msg.ts !== originalTs;\n  const reactions = msg.reactions || [];\n  const alreadyChecked = reactions.some(r => r.name === 'white_check_mark');\n  return hasTicket && isNotOriginal && !alreadyChecked;\n});\n\nif (duplicates.length === 0) {\n  return [];\n}\n\nreturn duplicates.map(msg => ({\n  ts: msg.ts,\n  channel,\n  ticketNumber,\n  text: (msg.text || '').substring(0, 80)\n}));"
      },
